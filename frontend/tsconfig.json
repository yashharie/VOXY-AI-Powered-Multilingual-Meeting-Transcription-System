{
    "compilerOptions":  {
                            "target":  "ESNext",
                            "useDefineForClassFields":  true,
                            "module":  "ESNext",
                            "moduleResolution":  "bundler",
                            "allowImportingTsExtensions":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "skipLibCheck":  true,
                            "types":  [
                                          "svelte",
                                          "vite/client"
                                      ],
                            "baseUrl":  ".",
                            "paths":  {
                                          "$lib/*":  [
                                                         "src/lib/*"
                                                     ]
                                      }
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.svelte",
                    "vite.config.ts"
                ]
}